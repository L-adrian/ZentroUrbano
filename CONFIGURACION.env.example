# Plantilla sin secretos. Introducir valores reales en Environment Variables de Hostinger.
NEXT_PUBLIC_SITE_URL=https://zentrourbano.com
DATABASE_URL=
MYSQL_CONNECTION_LIMIT=5
ZENTRO_REQUIRE_DATABASE=1
ZENTRO_URBANO_ADMIN_USER=
ZENTRO_URBANO_ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: casilla "no soy un robot" de Cloudflare Turnstile en el registro y en las reservas de visita.
# Sin estas dos claves el registro igual queda protegido (formulario firmado, campo trampa y limites).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GOOGLE_REDIRECT_URI=https://zentrourbano.com/api/auth/google/callback
# Solo durante la migracion: nombre exacto de la base que ya creaste y respaldaste.
ZENTRO_CONFIRM_DATABASE=
